# ============================================
# PawZHub Backend API - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Server Port
PORT=3000

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/pawzhub

# Admin API Token (for /admin/* routes)
ADMIN_TOKEN=change_this_to_a_secret_token

# Discord Webhook for logging (optional)
DISCORD_WEBHOOK_URL=
