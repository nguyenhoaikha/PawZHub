# PawZHub Discord Bot v2.1 Pro - Environment Variables
# Copy this to .env and fill in your values

# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_bot_token_here

# Application/Client ID (from https://discord.com/developers/applications)
CLIENT_ID=your_application_id_here

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/pawzhub

# Admin Role IDs (comma-separated, for /admin commands)
# Leave empty to fallback to role name matching (Admin, PawZHub Admin, Owner)
ADMIN_ROLE_IDS=

# Log Channel ID (optional - for logging admin actions)
LOG_CHANNEL_ID=

# Discord Webhook for logging (optional)
DISCORD_WEBHOOK_URL=
