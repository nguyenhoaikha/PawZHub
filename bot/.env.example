# PawZHub Discord Bot — Environment Configuration
# Copy this to .env and fill in real values.

# Discord bot credentials (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_GUILD_ID=your-test-server-id

# PawZHub Web API (Vercel deployment)
WEB_API_URL=https://getpawzhub.vercel.app
WEB_ADMIN_TOKEN=your-admin-token-from-vercel-env

# Comma-separated Discord user IDs allowed to use admin commands
# (keygen, blacklist, unblacklist, stats)
ADMIN_USER_IDS=123456789012345678
