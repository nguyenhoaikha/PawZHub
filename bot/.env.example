# PawZHub Discord Bot — Environment Template
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to git.

# ──────────────────────────────────────────────────────────────
# Discord credentials
# Get from: https://discord.com/developers/applications
# ──────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_GUILD_ID=your-discord-server-id

# ──────────────────────────────────────────────────────────────
# PawZHub Web API
# ──────────────────────────────────────────────────────────────
# URL of your Vercel deployment (no trailing slash)
WEB_API_URL=https://getpawzhub.vercel.app

# Must match ADMIN_TOKEN in Vercel environment variables
WEB_ADMIN_TOKEN=your-admin-token-from-vercel-env

# Must match BOT_REDEEM_TOKEN in Vercel environment variables
# Used by the /redeem command to call /api/redeem
BOT_REDEEM_TOKEN=your-bot-redeem-token-from-vercel-env

# ──────────────────────────────────────────────────────────────
# Admin permissions
# Comma-separated Discord user IDs allowed to use admin commands
# (keygen, blacklist, unblacklist, revoke-key, inspect-key, stats)
# ──────────────────────────────────────────────────────────────
ADMIN_USER_IDS=discord_user_id_1,discord_user_id_2
